---
import { features } from '../data/content'
import Icon from './Icon.astro'

const toneBg: Record<string, string> = {
  ink:   'var(--ink-faint)',
  rose:  'var(--rose-light)',
  sage:  'var(--sage-light)',
  gold:  'var(--gold-light)',
  mauve: 'var(--mauve-light)',
}
const toneFg: Record<string, string> = {
  ink:   'var(--ink-light)',
  rose:  'var(--rose-dark)',
  sage:  'var(--sage)',
  gold:  'var(--gold)',
  mauve: 'var(--mauve)',
}
---

<section class="features" id="fonctionnalites">
  <div class="container-x">
    <div class="section-head reveal">
      <span class="eyebrow"><Icon name="sparkle" size={16} /> L’outil complet</span>
      <h2>Tout votre métier,<br /><em>au même endroit</em></h2>
      <p class="section-sub">
        MeGesti ne superpose pas des modules génériques. Il modélise le métier réel
        de l’édition : livres, auteurs, salons, dépôts-vente, droits et conformité fiscale.
      </p>
    </div>

    <div class="features-grid">
      {features.map((f, i) => (
        <article class="feature-card reveal" style={`--tone-bg:${toneBg[f.tone]};--tone-fg:${toneFg[f.tone]};transition-delay:${i * 60}ms`}>
          <div class="feature-icon">
            <Icon name={f.icon} size={26} />
          </div>
          <h3>{f.title}</h3>
          <p>{f.text}</p>
          {f.status && <span class="feature-status">en cours</span>}
        </article>
      ))}
    </div>
  </div>
</section>

<style>
  .features {
    padding: 6rem 0;
    position: relative;
    z-index: 1;
  }
  .section-head {
    text-align: center;
    max-width: 680px;
    margin: 0 auto 3.5rem;
  }
  .section-head h2 {
    margin: 1rem 0;
  }
  .section-head h2 em { color: var(--rose-dark); font-style: italic; }
  .section-sub {
    font-size: 1.1rem;
    color: var(--text-mid);
    line-height: 1.6;
  }

  .features-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 1.25rem;
  }
  .feature-card {
    position: relative;
    background: var(--white);
    border: 1px solid var(--cream-dark);
    border-radius: var(--radius-card);
    padding: 1.75rem 1.5rem;
    transition: transform 0.3s var(--ease-out), box-shadow 0.3s var(--ease-out);
  }
  .feature-card:hover {
    transform: translateY(-4px);
    box-shadow: var(--shadow-hover);
  }
  .feature-icon {
    width: 52px; height: 52px;
    display: flex;
    align-items: center;
    justify-content: center;
    background: var(--tone-bg);
    color: var(--tone-fg);
    border-radius: 14px;
    margin-bottom: 1.1rem;
  }
  .feature-card h3 {
    font-family: 'Plus Jakarta Sans', sans-serif;
    font-size: 1.1rem;
    font-weight: 700;
    color: var(--ink-deep);
    margin-bottom: 0.5rem;
    line-height: 1.3;
  }
  .feature-card p {
    font-size: 0.93rem;
    color: var(--text-mid);
    line-height: 1.55;
  }
  .feature-status {
    display: inline-block;
    margin-top: 0.75rem;
    font-size: 0.72rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--gold);
    background: var(--gold-light);
    padding: 0.2rem 0.55rem;
    border-radius: var(--radius-pill);
  }

  @media (max-width: 1080px) {
    .features-grid { grid-template-columns: repeat(2, 1fr); }
  }
  @media (max-width: 560px) {
    .features-grid { grid-template-columns: 1fr; }
  }
</style>
