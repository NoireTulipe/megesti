---
import { site } from '../data/content'
import Icon from './Icon.astro'
---

<section class="showcase" id="pitch">
  <!-- Orbes lumineux discrets (sans watermark) -->
  <div class="orbs" aria-hidden="true">
    <span class="orb orb-rose"></span>
    <span class="orb orb-mauve"></span>
  </div>

  <div class="container-x showcase-inner">
    <div class="showcase-copy reveal">
      <span class="hero-badge">
        <span class="pulse-dot"></span>
        {site.availability}
      </span>

      <h2 class="showcase-title">
        Un seul outil<br /><em>pour tout votre métier</em>
      </h2>

      <p class="showcase-lead">
        Catalogue, ventes en salon, droits d’auteur et conformité fiscale&nbsp;:
        <strong>MeGesti réunit l’essentiel de votre activité d’éditeur</strong> dans une seule interface claire.
      </p>

      <div class="showcase-cta">
        <a href="#forfaits" class="btn btn-primary">
          Demander un accès
          <Icon name="arrow" size={18} />
        </a>
        <a href={site.appUrl} class="btn btn-ghost">Se connecter</a>
      </div>

      <ul class="showcase-trust">
        <li><Icon name="check" size={16} /> Facturation électronique 2026-2027</li>
        <li><Icon name="check" size={16} /> Caisse conforme anti-fraude TVA</li>
        <li><Icon name="check" size={16} /> Fonctionne hors-ligne en salon</li>
      </ul>
    </div>

    <!-- Mockup de l'app -->
    <div class="showcase-visual reveal">
      <div class="mockup-frame">
        <div class="mockup-bar">
          <span></span><span></span><span></span>
          <div class="mockup-url">app.megesti.fr</div>
        </div>
        <div class="mockup-screen">
          <div class="mockup-sidebar">
            <div class="ms-logo"></div>
            <div class="ms-nav">
              <span class="ms-item active"></span>
              <span class="ms-item"></span>
              <span class="ms-item"></span>
              <span class="ms-item"></span>
              <span class="ms-item"></span>
            </div>
          </div>
          <div class="mockup-content">
            <div class="mc-head"></div>
            <div class="mc-cards">
              <div class="mc-card"></div>
              <div class="mc-card"></div>
              <div class="mc-card"></div>
            </div>
            <div class="mc-chart">
              <div class="bar" style="height:40%"></div>
              <div class="bar" style="height:65%"></div>
              <div class="bar" style="height:50%"></div>
              <div class="bar" style="height:85%"></div>
              <div class="bar" style="height:60%"></div>
              <div class="bar" style="height:75%"></div>
            </div>
          </div>
        </div>
      </div>
      <div class="mockup-shadow" aria-hidden="true"></div>

      <!-- Megestine -->
      <div class="megestine" aria-hidden="true">
        <div class="megestine-bubble">
          <span class="bubble-text">Bienvenue&nbsp;! Je suis MeGestine,<br/>votre accompagnatrice.</span>
        </div>
        <img src="/mascotte/megestine-1.png" alt="MeGestine, la mascotte MeGesti" class="megestine-img" />
      </div>
    </div>
  </div>
</section>

<style>
  .showcase {
    position: relative;
    overflow: hidden;
    padding: 8rem 0 7rem;
  }

  .orbs {
    position: absolute;
    inset: 0;
    z-index: 0;
    pointer-events: none;
  }
  .orb {
    position: absolute;
    border-radius: 50%;
    filter: blur(90px);
    opacity: 0.4;
    animation: orbDrift 18s ease-in-out infinite;
  }
  .orb-rose {
    width: 420px; height: 420px;
    background: var(--rose-mid);
    top: -100px; right: -60px;
  }
  .orb-mauve {
    width: 380px; height: 380px;
    background: var(--mauve);
    bottom: -100px; left: -60px;
    animation-delay: -7s;
  }
  @keyframes orbDrift {
    0%, 100% { transform: translate(0, 0) scale(1); }
    50%      { transform: translate(30px, -20px) scale(1.08); }
  }

  .showcase-inner {
    position: relative;
    z-index: 2;
    display: grid;
    grid-template-columns: 1.05fr 1fr;
    gap: 5rem;
    align-items: center;
  }

  .hero-badge {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    background: var(--white);
    box-shadow: var(--shadow-card);
    padding: 0.5rem 1rem;
    border-radius: var(--radius-pill);
    font-size: 0.85rem;
    font-weight: 600;
    color: var(--ink-deep);
    margin-bottom: 1.75rem;
  }
  .pulse-dot {
    width: 8px; height: 8px;
    border-radius: 50%;
    background: var(--sage);
    box-shadow: 0 0 0 0 rgba(107, 143, 113, 0.5);
    animation: pulse 2s infinite;
  }
  @keyframes pulse {
    0%   { box-shadow: 0 0 0 0 rgba(107,143,113,0.5); }
    70%  { box-shadow: 0 0 0 8px rgba(107,143,113,0); }
    100% { box-shadow: 0 0 0 0 rgba(107,143,113,0); }
  }

  .showcase-title {
    font-size: clamp(2.5rem, 5vw, 4rem);
    line-height: 1.05;
    margin-bottom: 1.5rem;
  }
  .showcase-title em {
    font-style: italic;
    color: var(--rose-dark);
  }

  .showcase-lead {
    font-size: 1.15rem;
    line-height: 1.6;
    color: var(--text-mid);
    max-width: 540px;
    margin-bottom: 2.25rem;
  }
  .showcase-lead strong { color: var(--ink-deep); }

  .showcase-cta {
    display: flex;
    gap: 0.75rem;
    flex-wrap: wrap;
    margin-bottom: 2.5rem;
  }

  .showcase-trust {
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
  }
  .showcase-trust li {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    font-size: 0.95rem;
    color: var(--text-mid);
  }
  .showcase-trust li :global(svg) {
    color: var(--sage);
    flex-shrink: 0;
  }

  /* ── Mockup ────────────────────────────────────────────── */
  .showcase-visual {
    position: relative;
  }
  .mockup-frame {
    position: relative;
    background: var(--white);
    border-radius: 18px;
    box-shadow: var(--shadow-float);
    overflow: hidden;
    border: 1px solid var(--cream-dark);
    z-index: 2;
    transform: perspective(1400px) rotateY(-6deg) rotateX(2deg);
    transition: transform 0.6s var(--ease-out);
  }
  .mockup-frame:hover {
    transform: perspective(1400px) rotateY(-3deg) rotateX(1deg) translateY(-4px);
  }
  .mockup-bar {
    display: flex;
    align-items: center;
    gap: 0.4rem;
    padding: 0.75rem 1rem;
    background: var(--cream-mid);
    border-bottom: 1px solid var(--cream-dark);
  }
  .mockup-bar span {
    width: 11px; height: 11px;
    border-radius: 50%;
    background: var(--cream-dark);
  }
  .mockup-bar span:nth-child(1) { background: #E0706B; }
  .mockup-bar span:nth-child(2) { background: #E5B85F; }
  .mockup-bar span:nth-child(3) { background: #7BB67C; }
  .mockup-url {
    margin-left: 0.75rem;
    padding: 0.25rem 0.85rem;
    background: var(--white);
    border-radius: var(--radius-pill);
    font-size: 0.75rem;
    color: var(--text-soft);
    border: 1px solid var(--cream-dark);
  }
  .mockup-screen {
    display: grid;
    grid-template-columns: 64px 1fr;
    height: 340px;
  }
  .mockup-sidebar {
    background: var(--gradient-night);
    padding: 1rem 0.5rem;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.85rem;
  }
  .ms-logo {
    width: 32px; height: 32px;
    border-radius: 9px;
    background: linear-gradient(135deg, var(--rose), var(--rose-dark));
    margin-bottom: 0.5rem;
  }
  .ms-item {
    width: 36px; height: 8px;
    border-radius: 4px;
    background: rgba(255,255,255,0.15);
  }
  .ms-item.active { background: var(--rose-mid); }

  .mockup-content {
    padding: 1.25rem;
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }
  .mc-head {
    height: 16px;
    width: 45%;
    border-radius: 6px;
    background: var(--cream-dark);
  }
  .mc-cards {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 0.75rem;
  }
  .mc-card {
    height: 64px;
    border-radius: 12px;
    background: linear-gradient(135deg, var(--cream-mid), var(--cream-dark));
  }
  .mc-chart {
    flex: 1;
    display: flex;
    align-items: flex-end;
    gap: 0.5rem;
    padding: 0.75rem;
    border-radius: 12px;
    background: var(--cream);
    border: 1px solid var(--cream-dark);
  }
  .mc-chart .bar {
    flex: 1;
    background: linear-gradient(180deg, var(--rose), var(--rose-dark));
    border-radius: 4px 4px 0 0;
    opacity: 0.85;
    animation: barGrow 1.2s var(--ease-out) 0.4s both;
    transform-origin: bottom;
  }
  @keyframes barGrow {
    from { transform: scaleY(0); }
    to   { transform: scaleY(1); }
  }

  .mockup-shadow {
    position: absolute;
    inset: 0;
    z-index: 1;
    background: radial-gradient(ellipse at center, var(--rose-glow), transparent 70%);
    transform: translateY(6%) scale(0.95);
    filter: blur(40px);
  }

  /* ── Megestine ─────────────────────────────────────────── */
  .megestine {
    position: absolute;
    bottom: -3rem;
    right: -2.5rem;
    display: flex;
    align-items: flex-end;
    gap: 0;
    z-index: 3;
  }
  .megestine-bubble {
    background: var(--white);
    border: 1px solid var(--cream-dark);
    border-radius: 18px;
    border-bottom-right-radius: 4px;
    padding: 0.8rem 1.1rem;
    box-shadow: var(--shadow-hover);
    max-width: 230px;
    margin-bottom: 3rem;
    margin-right: -1rem;
    position: relative;
  }
  .megestine-bubble::after {
    content: '';
    position: absolute;
    right: 14px;
    bottom: -10px;
    width: 18px;
    height: 18px;
    background: var(--white);
    border-right: 1px solid var(--cream-dark);
    border-bottom: 1px solid var(--cream-dark);
    transform: rotate(45deg);
  }
  .bubble-text {
    font-size: 0.88rem;
    font-weight: 500;
    color: var(--ink-deep);
    line-height: 1.4;
  }
  .megestine-img {
    width: 150px;
    height: auto;
    filter: drop-shadow(0 12px 24px rgba(44,33,24,0.2));
    animation: megestineFloat 5s ease-in-out infinite;
  }
  @keyframes megestineFloat {
    0%, 100% { transform: translateY(0) rotate(-2deg); }
    50%      { transform: translateY(-10px) rotate(2deg); }
  }

  @media (max-width: 960px) {
    .showcase-inner {
      grid-template-columns: 1fr;
      gap: 4rem;
    }
    .showcase-visual { max-width: 520px; margin: 0 auto; }
    .megestine { right: -1rem; bottom: -2rem; }
    .megestine-img { width: 120px; }
  }
  @media (max-width: 560px) {
    .showcase { padding: 5rem 0 6rem; }
    .megestine-bubble { max-width: 180px; }
    .megestine-img { width: 100px; }
  }

  @media (prefers-reduced-motion: reduce) {
    .orb, .megestine-img, .mc-chart .bar { animation: none; }
  }
</style>
