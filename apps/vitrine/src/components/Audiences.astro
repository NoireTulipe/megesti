---
import { audiences } from '../data/content'
import Icon from './Icon.astro'

const { editeur, auteur } = audiences
---

<section class="audiences" id="audiences">
  <div class="container-x">
    <div class="section-head reveal" style="text-align:center">
      <span class="eyebrow"><Icon name="sparkle" size={16} /> Deux métiers, un atelier</span>
      <h2>Éditeur ou auteur, <em>MeGesti travaille pour vous</em></h2>
    </div>

    <div class="audiences-grid">
      <!-- ── Panneau Éditeur ─────────────────────────────── -->
      <article class="panel panel-editeur reveal tilt" id={editeur.id}>
        <span class="panel-eyebrow">{editeur.eyebrow}</span>
        <h3>{editeur.title}</h3>
        <p class="panel-intro">{editeur.intro}</p>
        <ul class="panel-points">
          {editeur.points.map((p) => (
            <li>
              <span class="point-icon"><Icon name={p.icon} size={16} /></span>
              {p.text}
            </li>
          ))}
        </ul>
        <a href={editeur.cta.href} class="btn btn-primary">{editeur.cta.label} <Icon name="arrow" size={16} /></a>
      </article>

      <!-- ── Mascotte au centre ──────────────────────────── -->
      <div class="mascotte-wrap reveal" aria-hidden="true">
        <div class="mascotte-glow"></div>
        <img
          src="/mascotte/megestine-1.png"
          alt=""
          class="mascotte"
          width="280"
          height="280"
          loading="lazy"
        />
      </div>

      <!-- ── Panneau Auteur ──────────────────────────────── -->
      <article class="panel panel-auteur reveal tilt" id={auteur.id}>
        <span class="panel-eyebrow panel-eyebrow-auteur">{auteur.eyebrow}</span>
        <h3>{auteur.title}</h3>
        <p class="panel-intro">{auteur.intro}</p>
        {auteur.blocs.map((bloc) => (
          <div class="panel-bloc">
            <h4>{bloc.title}</h4>
            <ul class="panel-points">
              {bloc.points.map((text) => (
                <li>
                  <span class="point-icon point-icon-auteur"><Icon name="feather" size={16} /></span>
                  {text}
                </li>
              ))}
            </ul>
          </div>
        ))}
        <a href={auteur.cta.href} class="btn btn-ghost">{auteur.cta.label} <Icon name="arrow" size={16} /></a>
      </article>
    </div>
  </div>
</section>

<style>
  .audiences {
    padding: 5.5rem 0;
    position: relative;
    z-index: 1;
  }

  .audiences-grid {
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    gap: 1.5rem;
    align-items: stretch;
  }

  /* ── Panneaux ──────────────────────────────────────────── */
  .panel {
    position: relative;
    padding: 2.5rem 2.25rem;
    border-radius: var(--radius-card);
    background: var(--white);
    border: 1.5px solid var(--cream-dark);
    box-shadow: var(--shadow-card);
    display: flex;
    flex-direction: column;
    gap: 1.1rem;
    transition: transform 0.25s var(--ease-out), box-shadow 0.35s var(--ease-out);
    will-change: transform;
    scroll-margin-top: 90px;
  }
  .panel:hover { box-shadow: var(--shadow-hover); }

  .panel-editeur {
    border-top: 4px solid var(--ink-light);
    background: linear-gradient(180deg, var(--ink-faint) 0%, var(--white) 30%);
  }
  .panel-auteur {
    border-top: 4px solid var(--rose);
    background: linear-gradient(180deg, var(--rose-light) 0%, var(--white) 30%);
  }

  .panel-eyebrow {
    font-size: 0.78rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--ink-light);
  }
  .panel-eyebrow-auteur { color: var(--rose-dark); }

  .panel h3 { font-size: clamp(1.5rem, 2.4vw, 1.9rem); }
  .panel-intro { color: var(--text-mid); line-height: 1.6; font-size: 0.98rem; }

  .panel-bloc h4 {
    font-family: 'Plus Jakarta Sans', sans-serif;
    font-weight: 700;
    font-size: 0.95rem;
    color: var(--ink-deep);
    margin-bottom: 0.6rem;
  }

  .panel-points {
    display: flex;
    flex-direction: column;
    gap: 0.7rem;
  }
  .panel-points li {
    display: flex;
    gap: 0.7rem;
    align-items: flex-start;
    color: var(--text-mid);
    font-size: 0.95rem;
    line-height: 1.5;
  }
  .point-icon {
    flex-shrink: 0;
    width: 28px; height: 28px;
    border-radius: 9px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    background: var(--ink-faint);
    color: var(--ink-light);
    margin-top: 1px;
  }
  .point-icon-auteur { background: var(--rose-light); color: var(--rose-dark); }

  .panel .btn { margin-top: auto; align-self: flex-start; }

  /* ── Mascotte ──────────────────────────────────────────── */
  .mascotte-wrap {
    position: relative;
    align-self: center;
    width: 220px;
  }
  .mascotte-glow {
    position: absolute;
    inset: -10%;
    background: radial-gradient(circle, var(--rose-glow) 0%, transparent 70%);
    filter: blur(24px);
    animation: mascotteGlow 5s ease-in-out infinite;
  }
  @keyframes mascotteGlow {
    0%, 100% { opacity: 0.5; transform: scale(1); }
    50%      { opacity: 1; transform: scale(1.1); }
  }
  .mascotte {
    position: relative;
    width: 100%;
    height: auto;
    animation: mascotteFloat 7s ease-in-out infinite;
    filter: drop-shadow(0 16px 32px rgba(44, 33, 24, 0.18));
  }
  @keyframes mascotteFloat {
    0%, 100% { transform: translateY(0) rotate(0deg); }
    50%      { transform: translateY(-12px) rotate(1.5deg); }
  }

  /* ── Responsive ────────────────────────────────────────── */
  @media (max-width: 980px) {
    .audiences-grid { grid-template-columns: 1fr; }
    .mascotte-wrap { order: -1; margin: 0 auto; width: 160px; }
  }

  @media (prefers-reduced-motion: reduce) {
    .mascotte, .mascotte-glow { animation: none; }
  }
</style>

<script>
  // Tilt 3D léger au survol des panneaux — désactivé si reduced-motion
  if (!window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
    document.querySelectorAll<HTMLElement>('.tilt').forEach((el) => {
      el.addEventListener('mousemove', (e) => {
        const r = el.getBoundingClientRect()
        const x = (e.clientX - r.left) / r.width - 0.5
        const y = (e.clientY - r.top) / r.height - 0.5
        el.style.transform = `perspective(900px) rotateX(${(-y * 4).toFixed(2)}deg) rotateY(${(x * 4).toFixed(2)}deg) translateY(-2px)`
      })
      el.addEventListener('mouseleave', () => {
        el.style.transform = ''
      })
    })
  }
</script>
