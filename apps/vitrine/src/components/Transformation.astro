---
import Icon from './Icon.astro'

// La bascule : tout dans un bandeau sombre unique.
// Cards animées : "avant" estompée, "après" vibrante + shimmer.
const before = [
  ‘Un Excel chaotique par auteur pour les droits — qui date de l’an dernier’,
  ‘Les ventes salon griffonnées sur un cahier, recopiées le soir’,
  ‘La TVA recalculée en catastrophe en mars, les doigts croisés’,
  ‘Le stock exact entre deux dépôts et trois festivals ? Personne ne sait.’,
]
const after = [
  ‘Les droits d’auteur calculés au centime, à chaque vente’,
  ‘Chaque ticket encaissé, archivé, conforme — en direct’,
  ‘La TVA juste toute l’année, l’archivage journalier automatique’,
  ‘Le stock partout, en temps réel, même sans réseau en salon’,
]
---

<section class="transform" id="bascule">
  <div class="transform-bg" aria-hidden="true"></div>

  <div class="container-x transform-inner">
    <div class="transform-head reveal">
      <span class="bandeau-label">La bascule</span>
      <h2 class="bandeau-title">
        <span class="t-before">Avant, sans MeGesti</span>
        <span class="t-arrow" aria-hidden="true"><Icon name="arrow" size={28} /></span>
        <span class="t-after">Après, <em>avec MeGesti</em></span>
      </h2>
    </div>

    <!-- Les deux cards, contenues dans le bandeau -->
    <div class="cards">
      <!-- Card AVANT : estompée, grisée -->
      <article class="card card-before reveal" style="animation-delay:0.1s">
        <div class="card-head">
          <span class="col-tag tag-before">Sans MeGesti</span>
        </div>
        <ul>
          {before.map((p, i) => (
            <li style={`transition-delay:${i * 100}ms`}>
              <Icon name="close" size={20} class="x" />
              <span>{p}</span>
            </li>
          ))}
        </ul>
      </article>

      <!-- Card APRÈS : vibrante, halo, shimmer -->
      <article class="card card-after reveal" style="animation-delay:0.3s">
        <div class="shimmer" aria-hidden="true"></div>
        <div class="card-glow" aria-hidden="true"></div>
        <div class="card-head">
          <span class="col-tag tag-after">Avec MeGesti</span>
          <span class="star-badge"><Icon name="sparkle" size={14} /></span>
        </div>
        <ul>
          {after.map((g, i) => (
            <li style={`transition-delay:${300 + i * 100}ms`}>
              <Icon name="check" size={20} class="check" />
              <span>{g}</span>
            </li>
          ))}
        </ul>
      </article>
    </div>
  </div>
</section>

<style>
  .transform {
    position: relative;
    overflow: hidden;
    z-index: 1;
  }
  .transform-bg {
    position: absolute;
    inset: 0;
    background: linear-gradient(120deg, #1E1A2E 0%, #2A1F3D 50%, #1A2744 100%);
  }
  .transform-bg::before {
    content: '';
    position: absolute;
    top: 0; left: 0; right: 0;
    height: 4px;
    background: linear-gradient(90deg, var(--rose), var(--gold), var(--mauve));
  }
  .transform-bg::after {
    content: '';
    position: absolute;
    inset: 0;
    background:
      radial-gradient(circle at 12% 30%, rgba(196,144,124,0.16), transparent 40%),
      radial-gradient(circle at 88% 70%, rgba(201,147,58,0.14), transparent 40%);
  }
  .transform-inner {
    position: relative;
    z-index: 1;
    padding: 5rem 1.5rem 6rem;
  }

  /* ── En-tête ────────────────────────────────────────────── */
  .transform-head {
    text-align: center;
    margin-bottom: 3.5rem;
  }
  .bandeau-label {
    display: inline-block;
    font-size: 0.78rem;
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--gold);
    margin-bottom: 1rem;
    padding: 0.3rem 1rem;
    border: 1px solid rgba(201,147,58,0.4);
    border-radius: var(--radius-pill);
    background: rgba(201,147,58,0.08);
  }
  .bandeau-title {
    color: #fff;
    font-size: clamp(1.6rem, 3.5vw, 2.5rem);
    line-height: 1.2;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 1rem;
    flex-wrap: wrap;
  }
  .t-before {
    color: rgba(255,255,255,0.4);
    font-style: italic;
    text-decoration: line-through;
    text-decoration-color: rgba(196,144,124,0.5);
    text-decoration-thickness: 2px;
  }
  .t-arrow {
    display: inline-flex;
    color: var(--rose);
    animation: arrowPulse 2s ease-in-out infinite;
  }
  @keyframes arrowPulse {
    0%, 100% { transform: translateX(0); opacity: 0.7; }
    50%      { transform: translateX(8px); opacity: 1; }
  }
  .t-after {
    color: #fff;
    font-weight: 600;
  }
  .t-after em {
    font-style: italic;
    background: linear-gradient(120deg, var(--rose-mid), var(--gold));
    -webkit-background-clip: text;
    background-clip: text;
    -webkit-text-fill-color: transparent;
    color: transparent;
  }

  /* ── Cards (contenues dans le bandeau) ──────────────────── */
  .cards {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1.5rem;
    max-width: 980px;
    margin: 0 auto;
    align-items: start;
  }
  .card {
    position: relative;
    border-radius: var(--radius-card);
    padding: 2.25rem;
    overflow: hidden;
    border: 1px solid transparent;
  }

  /* Card AVANT : estompée, grisée, comme une vieille photo */
  .card-before {
    background: rgba(255,255,255,0.04);
    border-color: rgba(255,255,255,0.1);
    backdrop-filter: blur(6px);
    filter: saturate(0.5);
    opacity: 0.85;
    transition: filter 0.4s, opacity 0.4s;
  }
  .card-before:hover {
    filter: saturate(0.8);
    opacity: 1;
  }

  /* Card APRÈS : vibrante, halo rose, bordure lumineuse */
  .card-after {
    background: linear-gradient(160deg, #fff, var(--rose-light));
    border-color: var(--rose);
    box-shadow:
      0 0 0 1px rgba(196,144,124,0.3),
      0 20px 50px rgba(196,144,124,0.35);
    transform: translateY(-8px); /* légère élévation pour la valeur */
    transition: transform 0.4s var(--ease-spring), box-shadow 0.4s;
  }
  .card-after:hover {
    transform: translateY(-14px);
    box-shadow:
      0 0 0 1px rgba(196,144,124,0.5),
      0 28px 70px rgba(196,144,124,0.5);
  }

  /* Halo qui pulse derrière la card APRÈS */
  .card-glow {
    position: absolute;
    inset: -2px;
    background: linear-gradient(120deg, var(--rose), var(--gold));
    border-radius: var(--radius-card);
    z-index: -1;
    opacity: 0.4;
    filter: blur(16px);
    animation: glowBreath 4s ease-in-out infinite;
  }
  @keyframes glowBreath {
    0%, 100% { opacity: 0.3; }
    50%      { opacity: 0.6; }
  }

  /* Shimmer doré qui traverse la card APRÈS */
  .shimmer {
    position: absolute;
    top: 0;
    left: -60%;
    width: 50%;
    height: 100%;
    background: linear-gradient(
      105deg,
      transparent 0%,
      rgba(255,255,255,0.5) 45%,
      rgba(255,255,255,0.8) 50%,
      rgba(255,255,255,0.5) 55%,
      transparent 100%
    );
    transform: skewX(-18deg);
    animation: shimmerSweep 5s ease-in-out infinite;
    animation-delay: 1.5s;
    pointer-events: none;
  }
  @keyframes shimmerSweep {
    0%   { left: -60%; }
    60%  { left: 120%; }
    100% { left: 120%; }
  }

  /* ── Tête de card ───────────────────────────────────────── */
  .card-head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 1.75rem;
  }
  .col-tag {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 0.78rem;
    font-weight: 700;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    padding: 0.4rem 1rem;
    border-radius: var(--radius-pill);
  }
  .tag-before {
    color: rgba(255,255,255,0.6);
    background: rgba(255,255,255,0.08);
    border: 1px solid rgba(255,255,255,0.15);
  }
  .tag-after {
    color: var(--rose-dark);
    background: var(--rose-light);
  }
  .star-badge {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 30px; height: 30px;
    border-radius: 50%;
    background: linear-gradient(135deg, var(--rose), var(--gold));
    color: #fff;
    animation: starSpin 6s linear infinite;
  }
  @keyframes starSpin {
    from { transform: rotate(0deg); }
    to   { transform: rotate(360deg); }
  }

  /* ── Listes ─────────────────────────────────────────────── */
  .card ul {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }
  .card li {
    display: flex;
    align-items: flex-start;
    gap: 0.75rem;
    font-size: 1rem;
    line-height: 1.5;
    opacity: 0;
    transform: translateX(-12px);
    transition: opacity 0.5s var(--ease-out), transform 0.5s var(--ease-out);
  }
  /* Apparition en cascade quand la card devient visible */
  .reveal.is-visible li,
  .card.is-visible li {
    opacity: 1;
    transform: translateX(0);
  }
  .card-before li { color: rgba(255,255,255,0.55); }
  .card-before li :global(.x) { color: rgba(200,93,58,0.7); flex-shrink: 0; margin-top: 1px; }

  .card-after li { color: var(--ink-deep); font-weight: 500; }
  .card-after li :global(.check) {
    color: var(--sage);
    flex-shrink: 0;
    margin-top: 1px;
    animation: checkPop 0.4s var(--ease-spring) both;
  }
  @keyframes checkPop {
    0%   { transform: scale(0); }
    70%  { transform: scale(1.3); }
    100% { transform: scale(1); }
  }

  @media (max-width: 820px) {
    .cards { grid-template-columns: 1fr; max-width: 460px; }
    .card-after { transform: none; }
    .card-after:hover { transform: translateY(-4px); }
    .bandeau-title { gap: 0.4rem; }
    .t-arrow { transform: rotate(90deg); animation: none; }
  }

  @media (prefers-reduced-motion: reduce) {
    .shimmer, .card-glow, .star-badge, .t-arrow { animation: none; }
  }
</style>

<script>
  // Les items de liste s'animent en cascade quand la card entre dans l'écran.
  // (Le .reveal global gère l'entrée de la card ; ici on force le is-visible
  //  des items en s'appuyant sur l'observer du Layout.)
  // Rien à faire : le sélecteur .reveal.is-visible li est déjà câblé.
</script>
