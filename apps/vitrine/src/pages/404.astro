---
import Layout from '../layouts/Layout.astro'
import { site } from '../data/content'
import Icon from '../components/Icon.astro'
---

<Layout title={`Page introuvable — ${site.name}`}>
  <section class="not-found">
    <div class="container-x nf-inner">
      <span class="nf-code">404</span>
      <h1>Cette page s’est <em>perdue</em><br />dans la bibliothèque</h1>
      <p>La page que vous cherchez n’existe pas (ou plus). Revenons à l’accueil.</p>
      <a href="/" class="btn btn-primary">
        <Icon name="arrow" size={18} style="transform:rotate(180deg)" />
        Retour à l’accueil
      </a>
    </div>
  </section>
</Layout>

<style>
  .not-found {
    padding: 8rem 0;
    text-align: center;
  }
  .nf-inner {
    max-width: 560px;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 1.25rem;
  }
  .nf-code {
    font-family: 'DM Serif Display', serif;
    font-style: italic;
    font-size: 6rem;
    color: var(--rose);
    line-height: 1;
  }
  .not-found h1 {
    font-size: clamp(2rem, 4vw, 2.75rem);
  }
  .not-found h1 em { color: var(--rose-dark); font-style: italic; }
  .not-found p { color: var(--text-mid); font-size: 1.1rem; }
</style>
