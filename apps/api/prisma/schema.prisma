generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── Tenant ──────────────────────────────────────────────────────────────────

model Tenant {
  id        String   @id @default(uuid())
  name      String
  slug      String   @unique
  theme                Json?
  plan                 PlanType @default(TRIAL)
  stripeCustomerId     String?
  stripeSubscriptionId String?
  stripePriceId        String?
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  users                  User[]
  thesauri               Thesaurus[]
  customFieldDefinitions CustomFieldDefinition[]
  auteurs                  Auteur[]
  maisonsEdition           MaisonEdition[]
  depotsLibraires          DepotLibraire[]
  salons                   Salon[]
  categoriesPointDeVente   CategoriePointDeVente[]
  pointsDeVente            PointDeVente[]
  sessionsCaisse           SessionCaisse[]
  ventes                   Vente[]
  rayons                   Rayon[]
  categories             Categorie[]
  articles               Article[]
  typesDA                TypeDA[]
  contratsAuteur         ContratAuteur[]
  archivesJournalieres   ArchiveJournaliere[]
}

// ─── User ─────────────────────────────────────────────────────────────────────

enum UserRole {
  ADMIN
  EDITOR
  AUTHOR
}

enum PlanType {
  TRIAL
  STARTER
  PRO
}

model User {
  id           String   @id @default(uuid())
  tenantId     String
  email        String
  passwordHash String
  firstName    String
  lastName     String
  role         UserRole @default(EDITOR)
  active       Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, email])
  @@index([tenantId])
}

// ─── Thésaurus ───────────────────────────────────────────────────────────────

model Thesaurus {
  id      String  @id @default(uuid())
  tenantId String
  nameFr  String
  nameEn  String?
  descFr  String?
  descEn  String?

  tenant  Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  entries ThesaurusEntry[]

  @@index([tenantId])
}

model ThesaurusEntry {
  id          String  @id @default(uuid())
  thesaurusId String
  labelFr     String
  labelEn     String?
  position    Int     @default(0)
  parentId    String?

  thesaurus Thesaurus       @relation(fields: [thesaurusId], references: [id], onDelete: Cascade)
  parent    ThesaurusEntry? @relation("EntryChildren", fields: [parentId], references: [id])
  children  ThesaurusEntry[] @relation("EntryChildren")

  @@index([thesaurusId])
  @@index([parentId])
}

// ─── Catalogue ───────────────────────────────────────────────────────────────

// ─── Ventes ───────────────────────────────────────────────────────────────────

model CategoriePointDeVente {
  id       String @id @default(uuid())
  tenantId String
  nom      String
  ordre    Int    @default(0)

  tenant        Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  pointsDeVente PointDeVente[]

  @@unique([tenantId, nom])
  @@index([tenantId])
}

model PointDeVente {
  id                 String   @id @default(uuid())
  tenantId           String
  categorieId        String?
  nom                String
  commissionFixe     Decimal? @db.Decimal(10, 2)
  commissionPourcent Decimal? @db.Decimal(5, 2)
  encaissementDirect Boolean  @default(true)
  actif              Boolean  @default(true)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  tenant    Tenant                 @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  categorie CategoriePointDeVente? @relation(fields: [categorieId], references: [id])
  sessions  SessionCaisse[]

  @@index([tenantId])
}

enum StatutSession {
  OUVERTE
  FERMEE
}

model SessionCaisse {
  id             String        @id @default(uuid())
  tenantId       String
  pointDeVenteId String
  salonId        String?
  nom            String?
  dateOuverture  DateTime      @default(now())
  dateFermeture  DateTime?
  fondOuverture  Decimal       @default(0) @db.Decimal(10, 2)
  fondFermeture  Decimal?      @db.Decimal(10, 2)
  debiterStockME Boolean       @default(true)
  statut         StatutSession @default(OUVERTE)
  createdAt      DateTime      @default(now())

  tenant       Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  pointDeVente PointDeVente @relation(fields: [pointDeVenteId], references: [id])
  salon        Salon?       @relation(fields: [salonId], references: [id])
  ventes       Vente[]

  @@index([tenantId])
  @@index([pointDeVenteId])
  @@index([salonId])
}

enum ModePaiement {
  CB
  ESPECES
  CHEQUE
  VIREMENT
  SUMUP
}

enum StatutVente {
  VALIDEE
  ANNULEE
}

model Vente {
  id             String       @id @default(uuid())
  tenantId       String
  sessionId      String
  numero         Int
  dateVente      DateTime     @default(now())
  modePaiement   ModePaiement
  totalHT        Decimal      @db.Decimal(10, 2)
  totalTVA       Decimal      @db.Decimal(10, 2)
  totalTTC       Decimal      @db.Decimal(10, 2)
  statut         StatutVente  @default(VALIDEE)
  noteAnnulation String?
  previousHash   String?      @db.VarChar(64)
  hash           String?      @db.VarChar(64)
  createdAt      DateTime     @default(now())

  tenant  Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  session SessionCaisse @relation(fields: [sessionId], references: [id])
  lignes  LigneVente[]

  @@unique([tenantId, numero])
  @@index([tenantId])
  @@index([sessionId])
}

model LigneVente {
  id             String  @id @default(uuid())
  venteId        String
  articleId      String
  quantite       Int
  prixUnitaireHT Decimal @db.Decimal(10, 2)
  tauxTVA        Decimal @db.Decimal(5, 2)
  totalLigneHT   Decimal @db.Decimal(10, 2)
  totalLigneTTC  Decimal @db.Decimal(10, 2)

  vente   Vente   @relation(fields: [venteId], references: [id], onDelete: Cascade)
  article Article @relation(fields: [articleId], references: [id])

  @@index([venteId])
  @@index([articleId])
}

// ─── Catalogue ───────────────────────────────────────────────────────────────

model Rayon {
  id          String  @id @default(uuid())
  tenantId    String
  nom         String
  ordre       Int     @default(0)
  isLibrairie Boolean @default(false)
  tauxTVA     Decimal @default(20) @db.Decimal(5, 2)

  tenant     Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  categories Categorie[]
  articles   Article[]
  customFields CustomFieldDefinition[]

  @@unique([tenantId, nom])
  @@index([tenantId])
}

model Categorie {
  id       String @id @default(uuid())
  tenantId String
  rayonId  String
  nom      String
  ordre    Int    @default(0)

  tenant   Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  rayon    Rayon     @relation(fields: [rayonId], references: [id], onDelete: Cascade)
  articles Article[]

  @@unique([rayonId, nom])
  @@index([tenantId])
  @@index([rayonId])
}

model Article {
  id              String    @id @default(uuid())
  tenantId        String
  rayonId         String
  categorieId     String?
  nom             String
  reference       String?
  description     String?
  imageUrl        String?
  prixVenteHT     Decimal   @db.Decimal(10, 2)
  prixAchatHT     Decimal?  @db.Decimal(10, 2)
  prixAchatLotHT  Decimal?  @db.Decimal(10, 2)
  prixAchatLotQte Int?
  stock           Int       @default(0)
  stockAlerte     Int       @default(0)
  stockTension    Int       @default(0)
  actif           Boolean   @default(true)
  // Champs librairie — null pour les autres rayons
  isbn            String?
  datePublication DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  tenant    Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  rayon     Rayon          @relation(fields: [rayonId], references: [id])
  categorie Categorie?     @relation(fields: [categorieId], references: [id])
  auteurs      ArticleAuteur[]
  lignesVente  LigneVente[]
  contrats     ContratAuteur[]

  @@index([tenantId])
  @@index([tenantId, rayonId])
}

model ArticleAuteur {
  articleId String
  auteurId  String
  ordre     Int    @default(0)

  article Article @relation(fields: [articleId], references: [id], onDelete: Cascade)
  auteur  Auteur  @relation(fields: [auteurId],  references: [id], onDelete: Cascade)

  @@id([articleId, auteurId])
  @@index([auteurId])
}

// ─── Auteur ───────────────────────────────────────────────────────────────────

model Auteur {
  id         String   @id @default(uuid())
  tenantId   String
  prenom     String
  nom        String
  pseudonyme String?
  email      String?
  bio        String?
  actif      Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  tenant   Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  articles ArticleAuteur[]
  contrats ContratAuteur[]

  @@index([tenantId])
}

// ─── Réseau ───────────────────────────────────────────────────────────────────

model MaisonEdition {
  id         String   @id @default(uuid())
  tenantId   String
  nom        String
  siret      String?
  email      String?
  telephone  String?
  adresse    String?
  actif      Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
}

model DepotLibraire {
  id         String   @id @default(uuid())
  tenantId   String
  nom        String
  contact    String?
  adresse    String?
  actif      Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
}

model Salon {
  id         String    @id @default(uuid())
  tenantId   String
  nom        String
  lieu       String?
  dateDebut  DateTime?
  dateFin    DateTime?
  actif      Boolean   @default(true)
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  tenant   Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  sessions SessionCaisse[]

  @@index([tenantId])
}

// ─── Champs personnalisés ─────────────────────────────────────────────────────

enum FieldType {
  text
  textarea
  number
  date
  boolean
  select
  thesaurus
}

enum EntityType {
  auteur
  maisonEdition
  depotLibraire
  salon
  pointDeVente
}

model CustomFieldDefinition {
  id          String      @id @default(uuid())
  tenantId    String
  entityType  EntityType? // null si scopé à un rayon
  rayonId     String?     // null si scopé à un entityType
  labelFr     String
  labelEn     String?
  fieldType   FieldType
  position    Int         @default(0)
  required    Boolean     @default(false)
  thesaurusId String?
  options     Json?
  category    String?
  halfWidth   Boolean     @default(false)
  placeholder String?
  validation  Json?       // { type, pattern?, message }

  tenant Tenant               @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  rayon  Rayon?               @relation(fields: [rayonId], references: [id], onDelete: Cascade)
  values CustomFieldValue[]

  @@index([tenantId, entityType])
  @@index([tenantId, rayonId])
}

model CustomFieldValue {
  id           String  @id @default(uuid())
  definitionId String
  entityId     String
  valueText    String?
  valueNumber  Float?
  valueBoolean Boolean?

  definition CustomFieldDefinition @relation(fields: [definitionId], references: [id], onDelete: Cascade)

  @@unique([definitionId, entityId])
  @@index([entityId])
}

// ─── Droits d'auteur ─────────────────────────────────────────────────────────

model TypeDA {
  id       String @id @default(uuid())
  tenantId String
  nom      String
  formule  Json   // FormuleDA — tableau de RegleDA ordonné

  tenant   Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  contrats ContratAuteur[]

  @@index([tenantId])
}

model ContratAuteur {
  id             String    @id @default(uuid())
  tenantId       String
  auteurId       String
  typeDAId       String
  articleId      String?   // null = tous les articles de cet auteur
  avance         Decimal?  @db.Decimal(10, 2)
  avanceDue      Decimal   @default(0) @db.Decimal(10, 2) // cumul versé à l'auteur avant recoupement
  dateDebut      DateTime?
  dateFin        DateTime?
  actif          Boolean   @default(true)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  tenant  Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  auteur  Auteur   @relation(fields: [auteurId],  references: [id])
  typeDA  TypeDA   @relation(fields: [typeDAId],   references: [id])
  article Article? @relation(fields: [articleId], references: [id])

  @@index([tenantId])
  @@index([auteurId])
  @@index([typeDAId])
}

// ─── Archivage journalier (loi anti-fraude TVA 2018) ─────────────────────────

model ArchiveJournaliere {
  id              String   @id @default(uuid())
  tenantId        String
  dateArchive     DateTime
  totalVentes     Int
  totalTTC        Decimal  @db.Decimal(12, 2)
  dernierHash     String   @db.VarChar(64)
  dernierNumero   Int
  createdAt       DateTime @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, dateArchive])
  @@index([tenantId])
}
