generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── Tenant ──────────────────────────────────────────────────────────────────

model Tenant {
  id        String   @id @default(uuid())
  name      String
  slug      String   @unique
  theme                Json?
  plan                 PlanType @default(AUTO_EDITION)
  stripeCustomerId     String?
  stripeSubscriptionId String?
  stripePriceId        String?
  franchiseBaseVA      Boolean  @default(false) // art. 293 B CGI — non assujetti TVA
  logo                 String?  // URL du logo uploadé
  siteWeb              String?  // URL du site internet de la ME
  presentation         String?  // Texte de présentation libre
  // Coordonnées légales (nécessaires pour la facturation électronique)
  siret                String?
  adresseLigne1        String?
  adresseLigne2        String?
  codePostal           String?
  ville                String?
  pays                 String?  @default("FR")
  numeroTVA            String?
  // Facturation électronique — superpdp.tech
  pdpClientId          String?  // client_id OAuth2 superpdp (par entreprise)
  pdpClientSecret      String?  // client_secret — chiffrer avant prod
  pdpLastInvoiceId     String?  // dernier ID reçu pour le polling
  facturesCredit       Int      @default(0) // crédits supplémentaires achetés via Stripe
  actif                Boolean  @default(true)
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  users                  User[]
  thesauri               Thesaurus[]
  customFieldDefinitions CustomFieldDefinition[]
  auteurs                  Auteur[]
  maisonsEdition           MaisonEdition[]
  depotsLibraires          DepotLibraire[]
  articlesDepot            ArticleDepot[]
  salons                   Salon[]
  contacts                 ContactTenant[]
  categoriesPointDeVente   CategoriePointDeVente[]
  pointsDeVente            PointDeVente[]
  sessionsCaisse           SessionCaisse[]
  ventes                   Vente[]
  rayons                   Rayon[]
  categories             Categorie[]
  articles               Article[]
  typesSalon             TypeSalon[]
  typesDA                TypeDA[]
  contratsAuteur         ContratAuteur[]
  archivesJournalieres   ArchiveJournaliere[]
  imprimeurs             Imprimeur[]
  mouvementsStock        MouvementStock[]
  frais                  Frais[]
  reversements           Reversement[]
  paiementsDA            PaiementDA[]
  charges                Charge[]
  motifsVente            MotifVente[]
  facturesEmises         FactureEmission[]
  facturesRecues         FactureReception[]
}

// ─── Facturation électronique ─────────────────────────────────────────────────

enum StatutFactureEmission {
  BROUILLON   // générée localement, non envoyée
  ENVOYEE     // soumise à superpdp
  ACCEPTEE    // confirmée par le destinataire (fr:212)
  REFUSEE     // rejetée par le destinataire (fr:220)
  ANNULEE     // annulée (fr:317)
}

model FactureEmission {
  id                String                @id @default(uuid())
  tenantId          String
  numero            String                // numéro séquentiel conforme (ex: F-2026-001)
  statut            StatutFactureEmission @default(BROUILLON)
  destinataireSiret String?
  destinataireNom   String?
  montantHT         Decimal               @db.Decimal(12, 2)
  montantTVA        Decimal               @db.Decimal(12, 2)
  montantTTC        Decimal               @db.Decimal(12, 2)
  format            String                @default("ubl")
  pdpId             String?               // ID retourné par superpdp après envoi
  dateEmission      DateTime
  dateEcheance      DateTime?
  contenuXml        String?               // UBL/Factur-X brut (stocké pour archivage 10 ans)
  createdAt         DateTime              @default(now())
  updatedAt         DateTime              @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([tenantId, dateEmission])
  @@index([pdpId])
}

model FactureReception {
  id              String   @id @default(uuid())
  tenantId        String
  pdpId           String                // ID chez superpdp
  emetteurSiret   String?
  emetteurNom     String?
  montantTTC      Decimal  @db.Decimal(12, 2)
  dateReception   DateTime
  statut          String   @default("RECUE")
  contenuXml      String?              // contenu brut pour archivage
  lu              Boolean  @default(false)
  createdAt       DateTime @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, pdpId])
  @@index([tenantId])
  @@index([tenantId, lu])
}

// ─── Admin ───────────────────────────────────────────────────────────────────

model AdminUser {
  id           String   @id @default(uuid())
  email        String   @unique
  passwordHash String
  nom          String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

// ─── MeGestine dialogs (CMS) ─────────────────────────────────────────────────

model MascoteDialog {
  id          String   @id @default(uuid())
  slug        String   @unique          // identifiant technique ex: catalogue-vide
  description String                    // note interne : où s'affiche ce dialog
  imageName   String   @default("m1.png") // fichier PNG dans /img/mascotte/
  bulles      Json                      // Bulle[] { title?, text, cta?: { label, href? } }
  actif       Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// ─── Popups ───────────────────────────────────────────────────────────────────

enum PopupMode {
  SHOW_ONCE        // visible une seule fois puis disparaît automatiquement
  DISMISSIBLE      // "Ne plus afficher ce message" — le user choisit
  ALWAYS_CLOSABLE  // revient à chaque fois, fermable (alerte non bloquante)
  ALWAYS_BLOCKING  // aucune fermeture possible (maintenance, message critique)
}

model Popup {
  id          String    @id @default(uuid())
  titre       String                         // libellé interne admin
  mode        PopupMode @default(DISMISSIBLE)
  dismissText String    @default("Ne plus afficher ce message")
  slides      Json                           // PopupSlide[] { imageName, title?, text, ctaLabel?, ctaHref? }
  targetPages Json      @default("[]")       // string[] — routes ciblées, [] = toutes
  actif       Boolean   @default(true)
  dateDebut   DateTime?
  dateFin     DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  vus         PopupVu[]
}

model PopupVu {
  id      String   @id @default(uuid())
  userId  String
  popupId String
  vuLe    DateTime @default(now())

  user  User  @relation(fields: [userId],  references: [id], onDelete: Cascade)
  popup Popup @relation(fields: [popupId], references: [id], onDelete: Cascade)

  @@unique([userId, popupId])
  @@index([userId])
}

// ─── User ─────────────────────────────────────────────────────────────────────

enum UserRole {
  ADMIN
  EDITOR
  AUTHOR
}

enum PlanType {
  TRIAL
  AUTO_EDITION
  EDITION
  EDITION_PRO
  // Deprecated — conservés pour compatibilité base existante
  STARTER
  PRO
}

model User {
  id           String   @id @default(uuid())
  tenantId     String
  email        String
  passwordHash String
  firstName    String
  lastName     String
  role         UserRole @default(EDITOR)
  active       Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  tenant    Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  popupsVus PopupVu[]

  @@unique([tenantId, email])
  @@index([tenantId])
}

// ─── Thésaurus ───────────────────────────────────────────────────────────────

model Thesaurus {
  id      String  @id @default(uuid())
  tenantId String
  nameFr  String
  nameEn  String?
  descFr  String?
  descEn  String?

  tenant  Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  entries ThesaurusEntry[]

  @@index([tenantId])
}

model ThesaurusEntry {
  id          String  @id @default(uuid())
  thesaurusId String
  labelFr     String
  labelEn     String?
  position    Int     @default(0)
  parentId    String?

  thesaurus Thesaurus       @relation(fields: [thesaurusId], references: [id], onDelete: Cascade)
  parent    ThesaurusEntry? @relation("EntryChildren", fields: [parentId], references: [id])
  children  ThesaurusEntry[] @relation("EntryChildren")

  @@index([thesaurusId])
  @@index([parentId])
}

// ─── Catalogue ───────────────────────────────────────────────────────────────

// ─── Ventes ───────────────────────────────────────────────────────────────────

model CategoriePointDeVente {
  id       String @id @default(uuid())
  tenantId String
  nom      String
  ordre    Int    @default(0)

  tenant        Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  pointsDeVente PointDeVente[]

  @@unique([tenantId, nom])
  @@index([tenantId])
}

model ContactPointDeVente {
  id             String              @id @default(uuid())
  pointDeVenteId String
  nom            String
  prenom         String?
  email          String?
  telephone      String?
  typePaiement   TypePaiementRemise?

  pointDeVente PointDeVente @relation(fields: [pointDeVenteId], references: [id], onDelete: Cascade)

  @@index([pointDeVenteId])
}

model PointDeVente {
  id                 String   @id @default(uuid())
  tenantId           String
  categorieId        String?
  salonId            String?  @unique  // PDV miroir d'un salon — null = PDV fixe
  nom                String
  commissionFixe     Decimal? @db.Decimal(10, 2)
  commissionPourcent Decimal? @db.Decimal(5, 2)
  encaissementDirect Boolean  @default(true)
  actif              Boolean  @default(true)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  tenant    Tenant                 @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  categorie CategoriePointDeVente? @relation(fields: [categorieId], references: [id])
  salon     Salon?                 @relation(fields: [salonId],    references: [id])
  sessions      SessionCaisse[]
  contacts      ContactPointDeVente[]
  reversements  Reversement[]

  @@index([tenantId])
  @@index([salonId])
}

enum StatutSession {
  OUVERTE
  FERMEE
}

model SessionCaisse {
  id             String        @id @default(uuid())
  tenantId       String
  pointDeVenteId String
  salonId        String?
  nom            String?
  dateOuverture  DateTime      @default(now())
  dateFermeture  DateTime?
  fondOuverture  Decimal       @default(0) @db.Decimal(10, 2)
  fondFermeture  Decimal?      @db.Decimal(10, 2)
  debiterStockME Boolean       @default(true)
  statut         StatutSession @default(OUVERTE)
  createdAt      DateTime      @default(now())

  tenant       Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  pointDeVente PointDeVente @relation(fields: [pointDeVenteId], references: [id])
  salon        Salon?       @relation(fields: [salonId], references: [id])
  ventes        Vente[]
  frais         Frais[]
  reversement   Reversement?

  @@index([tenantId])
  @@index([pointDeVenteId])
  @@index([salonId])
}

enum ModePaiement {
  CB
  ESPECES
  CHEQUE
  VIREMENT
  SUMUP
  PDV           // Encaissé par le point de vente (reverse ultérieur)
}

enum TypePaiementRemise {
  VIREMENT
  CHEQUE
}

enum StatutVente {
  VALIDEE
  ANNULEE
}

model MotifVente {
  id        String   @id @default(uuid())
  tenantId  String
  libelle   String
  ordre     Int      @default(0)
  actif     Boolean  @default(true)
  createdAt DateTime @default(now())

  tenant Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  ventes Vente[]

  @@index([tenantId])
}

model Vente {
  id             String       @id @default(uuid())
  tenantId       String
  sessionId      String?      // null = vente hors session
  motifVenteId   String?
  numero         Int
  dateVente      DateTime     @default(now())
  modePaiement   ModePaiement
  totalHT        Decimal      @db.Decimal(10, 2)
  totalTVA       Decimal      @db.Decimal(10, 2)
  totalTTC       Decimal      @db.Decimal(10, 2)
  statut         StatutVente  @default(VALIDEE)
  noteAnnulation String?
  previousHash   String?      @db.VarChar(64)
  hash           String?      @db.VarChar(64)
  createdAt      DateTime     @default(now())

  tenant      Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  session     SessionCaisse? @relation(fields: [sessionId],    references: [id])
  motifVente  MotifVente?    @relation(fields: [motifVenteId], references: [id])
  lignes      LigneVente[]

  @@unique([tenantId, numero])
  @@index([tenantId])
  @@index([sessionId])
  @@index([motifVenteId])
}

model LigneVente {
  id             String  @id @default(uuid())
  venteId        String
  articleId      String
  quantite       Int
  prixUnitaireHT Decimal @db.Decimal(10, 2)
  tauxTVA        Decimal @db.Decimal(5, 2)
  totalLigneHT   Decimal @db.Decimal(10, 2)
  totalLigneTTC  Decimal @db.Decimal(10, 2)

  vente   Vente   @relation(fields: [venteId], references: [id], onDelete: Cascade)
  article Article @relation(fields: [articleId], references: [id])

  @@index([venteId])
  @@index([articleId])
}

// ─── Catalogue ───────────────────────────────────────────────────────────────

model Rayon {
  id          String  @id @default(uuid())
  tenantId    String
  nom         String
  ordre       Int     @default(0)
  isLibrairie Boolean @default(false)
  tauxTVA     Decimal @default(20) @db.Decimal(5, 2)

  tenant     Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  categories Categorie[]
  articles   Article[]
  customFields CustomFieldDefinition[]

  @@unique([tenantId, nom])
  @@index([tenantId])
}

model Categorie {
  id       String @id @default(uuid())
  tenantId String
  rayonId  String
  nom      String
  ordre    Int    @default(0)

  tenant   Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  rayon    Rayon     @relation(fields: [rayonId], references: [id], onDelete: Cascade)
  articles Article[]

  @@unique([rayonId, nom])
  @@index([tenantId])
  @@index([rayonId])
}

model Article {
  id              String    @id @default(uuid())
  tenantId        String
  rayonId         String
  categorieId     String?
  nom             String
  reference       String?
  description     String?
  imageUrl        String?
  prixVenteHT     Decimal   @db.Decimal(10, 2)
  prixAchatHT     Decimal?  @db.Decimal(10, 2)
  prixAchatLotHT  Decimal?  @db.Decimal(10, 2)
  prixAchatLotQte Int?
  stock           Int       @default(0)
  stockAlerte     Int       @default(0)
  stockTension    Int       @default(0)
  actif           Boolean   @default(true)
  imprimeurId     String?
  // Champs librairie — null pour les autres rayons
  isbn            String?
  datePublication DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  tenant    Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  rayon     Rayon          @relation(fields: [rayonId], references: [id])
  categorie Categorie?     @relation(fields: [categorieId], references: [id])
  imprimeur Imprimeur?     @relation(fields: [imprimeurId], references: [id])
  auteurs      ArticleAuteur[]
  lignesVente  LigneVente[]
  contrats     ContratAuteur[]
  mouvements   MouvementStock[]
  depots       ArticleDepot[]

  @@index([tenantId])
  @@index([tenantId, rayonId])
}

model ArticleAuteur {
  articleId String
  auteurId  String
  ordre     Int    @default(0)

  article Article @relation(fields: [articleId], references: [id], onDelete: Cascade)
  auteur  Auteur  @relation(fields: [auteurId],  references: [id], onDelete: Cascade)

  @@id([articleId, auteurId])
  @@index([auteurId])
}

// ─── Auteur ───────────────────────────────────────────────────────────────────

model Auteur {
  id         String   @id @default(uuid())
  tenantId   String
  prenom     String
  nom        String
  pseudonyme String?
  email      String?
  bio        String?
  isVirtuel  Boolean  @default(false) // auteur virtuel créé pour plan Auto-édition
  actif      Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  tenant     Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  articles   ArticleAuteur[]
  contrats   ContratAuteur[]
  paiements  PaiementDA[]

  @@index([tenantId])
}

// ─── Réseau ───────────────────────────────────────────────────────────────────

model Imprimeur {
  id            String   @id @default(uuid())
  tenantId      String
  nom           String
  lienCommande  String?
  pointsForts   Json?    // String[]
  pointsFaibles Json?    // String[]
  noteLibre     String?
  actif         Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  tenant   Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  contacts ContactImprimeur[]
  articles Article[]

  @@index([tenantId])
}

model ContactImprimeur {
  id          String  @id @default(uuid())
  imprimeurId String
  nom         String
  prenom      String?
  email       String?
  telephone   String?

  imprimeur Imprimeur @relation(fields: [imprimeurId], references: [id], onDelete: Cascade)

  @@index([imprimeurId])
}

model MaisonEdition {
  id         String   @id @default(uuid())
  tenantId   String
  nom        String
  siret      String?
  email      String?
  telephone  String?
  adresse    String?
  actif      Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
}

model DepotLibraire {
  id                 String   @id @default(uuid())
  tenantId           String
  nom                String
  adresse            String?
  commissionFixe     Decimal? @db.Decimal(10,2)
  commissionPourcent Decimal? @db.Decimal(5,2)
  actif              Boolean  @default(true)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  tenant    Tenant                 @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  contacts  ContactDepotLibraire[]
  articles  ArticleDepot[]

  @@index([tenantId])
}

model ContactDepotLibraire {
  id              String  @id @default(uuid())
  depotLibraireId String
  nom             String
  prenom          String?
  email           String?
  telephone       String?

  depotLibraire DepotLibraire @relation(fields: [depotLibraireId], references: [id], onDelete: Cascade)

  @@index([depotLibraireId])
}

model ArticleDepot {
  id              String   @id @default(uuid())
  tenantId        String
  depotLibraireId String
  articleId       String
  quantiteEnvoyee Int
  quantiteVendue  Int      @default(0)
  dateEnvoi       DateTime @default(now())
  notes           String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  tenant        Tenant        @relation(fields: [tenantId],        references: [id], onDelete: Cascade)
  depotLibraire DepotLibraire @relation(fields: [depotLibraireId], references: [id], onDelete: Cascade)
  article       Article       @relation(fields: [articleId],       references: [id])

  @@index([tenantId])
  @@index([depotLibraireId])
  @@index([articleId])
}

model TypeSalon {
  id       String @id @default(uuid())
  tenantId String
  libelle  String

  tenant Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  salons Salon[]

  @@unique([tenantId, libelle])
  @@index([tenantId])
}

model Salon {
  id                 String    @id @default(uuid())
  tenantId           String
  nom                String
  typeSalonId        String?
  lieu               String?
  adresse            String?
  ville              String?
  pays               String?
  dateDebut          DateTime?
  dateFin            DateTime?
  dureeJours         Int?
  periodeHabituelle  String?   // ex. "Printemps", "Automne"
  prixPrevuFixe      Decimal?  @db.Decimal(10, 2)
  prixPrevuPct       Decimal?  @db.Decimal(5, 2)
  note               Int?      // 0–5 étoiles
  commentaires       String?
  actif              Boolean   @default(true)
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  tenant       Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  typeSalon    TypeSalon?      @relation(fields: [typeSalonId], references: [id])
  sessions     SessionCaisse[]
  contacts     ContactSalon[]
  pointDeVente PointDeVente?

  @@index([tenantId])
}

model ContactSalon {
  id        String  @id @default(uuid())
  salonId   String
  nom       String
  prenom    String?
  email     String?
  telephone String?

  salon Salon @relation(fields: [salonId], references: [id], onDelete: Cascade)

  @@index([salonId])
}

model ContactTenant {
  id        String  @id @default(uuid())
  tenantId  String
  nom       String
  prenom    String?
  email     String?
  telephone String?
  fonction  String?

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
}

// ─── Champs personnalisés ─────────────────────────────────────────────────────

enum FieldType {
  text
  textarea
  number
  date
  boolean
  select
  thesaurus
}

enum EntityType {
  auteur
  maisonEdition
  depotLibraire
  salon
  pointDeVente
}

model CustomFieldDefinition {
  id          String      @id @default(uuid())
  tenantId    String
  entityType  EntityType? // null si scopé à un rayon
  rayonId     String?     // null si scopé à un entityType
  labelFr     String
  labelEn     String?
  fieldType   FieldType
  position    Int         @default(0)
  required    Boolean     @default(false)
  thesaurusId String?
  options     Json?
  category    String?
  halfWidth   Boolean     @default(false)
  placeholder String?
  validation  Json?       // { type, pattern?, message }

  tenant Tenant               @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  rayon  Rayon?               @relation(fields: [rayonId], references: [id], onDelete: Cascade)
  values CustomFieldValue[]

  @@index([tenantId, entityType])
  @@index([tenantId, rayonId])
}

model CustomFieldValue {
  id           String  @id @default(uuid())
  definitionId String
  entityId     String
  valueText    String?
  valueNumber  Float?
  valueBoolean Boolean?

  definition CustomFieldDefinition @relation(fields: [definitionId], references: [id], onDelete: Cascade)

  @@unique([definitionId, entityId])
  @@index([entityId])
}

// ─── Droits d'auteur ─────────────────────────────────────────────────────────

enum PeriodiciteDA {
  MENSUEL
  TRIMESTRIEL
  TOUS_LES_4_MOIS
  SEMESTRIEL
  ANNUEL
  DATES_FIXES
}

enum StatutPaiementDA {
  PREVU
  PAYE
  ANNULE
}

model TypeDA {
  id       String @id @default(uuid())
  tenantId String
  nom      String
  formule  Json   // FormuleDA — tableau de RegleDA ordonné

  tenant   Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  contrats ContratAuteur[]

  @@index([tenantId])
}

model ContratAuteur {
  id               String    @id @default(uuid())
  tenantId         String
  auteurId         String
  typeDAId         String
  articleId        String?   // null = tous les articles de cet auteur
  avance            Decimal?       @db.Decimal(10, 2)
  avanceDue         Decimal        @default(0) @db.Decimal(10, 2)
  dateSignature     DateTime?
  datePriseEffet    DateTime?      // date d'effet (= signature si null)
  dureeAns          Int?           // null = durée indéterminée
  reconduiteTacite  Boolean        @default(true)
  periodicite       PeriodiciteDA?
  datesFixesJSON    Json?          // [{"mois":4,"jour":1},...] si DATES_FIXES
  prochainVersement DateTime?      // calculé à chaque paiement
  actif             Boolean        @default(true)
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt

  tenant    Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  auteur    Auteur       @relation(fields: [auteurId],  references: [id])
  typeDA    TypeDA       @relation(fields: [typeDAId],   references: [id])
  article   Article?     @relation(fields: [articleId], references: [id])
  paiements PaiementDA[]

  @@index([tenantId])
  @@index([auteurId])
  @@index([typeDAId])
}

model PaiementDA {
  id               String            @id @default(uuid())
  tenantId         String
  contratId        String
  auteurId         String
  montant          Decimal           @db.Decimal(10, 2)
  dateVersement    DateTime
  dateDebutPeriode DateTime
  dateFinPeriode   DateTime
  statut           StatutPaiementDA  @default(PREVU)
  modePaiement     TypePaiementRemise?
  reference        String?
  notes            String?
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt

  tenant  Tenant        @relation(fields: [tenantId],  references: [id], onDelete: Cascade)
  contrat ContratAuteur @relation(fields: [contratId], references: [id], onDelete: Cascade)
  auteur  Auteur        @relation(fields: [auteurId],  references: [id])

  @@index([tenantId])
  @@index([tenantId, statut])
  @@index([contratId])
  @@index([auteurId])
}

// ─── Reversements PDV ────────────────────────────────────────────────────────

enum StatutReversement {
  EN_ATTENTE
  ENCAISSE
  ANNULE
}

model Reversement {
  id              String             @id @default(uuid())
  tenantId        String
  pointDeVenteId  String
  sessionId       String             @unique
  montantTTC      Decimal            @db.Decimal(10, 2)
  nbVentes        Int
  statut          StatutReversement  @default(EN_ATTENTE)
  dateCloture     DateTime
  dateEncaissement DateTime?
  modePaiement    TypePaiementRemise?
  reference       String?
  notes           String?
  montantAjuste   Decimal?           @db.Decimal(10, 2) // null = montantTTC - commission
  noteAjustement  String?
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt

  tenant       Tenant         @relation(fields: [tenantId],       references: [id], onDelete: Cascade)
  pointDeVente PointDeVente   @relation(fields: [pointDeVenteId], references: [id])
  session      SessionCaisse  @relation(fields: [sessionId],      references: [id])

  @@index([tenantId])
  @@index([tenantId, statut])
}

// ─── Mouvements de stock ──────────────────────────────────────────────────────

enum TypeMouvement {
  ENTREE
  SORTIE_DON
  SORTIE_PERTE
  SORTIE_VOL
  SORTIE_DEGRADATION
  AJUSTEMENT
}

model MouvementStock {
  id         String        @id @default(uuid())
  tenantId   String
  articleId  String
  type       TypeMouvement
  delta      Int           // positif = entrée, négatif = sortie
  stockAvant Int
  stockApres Int
  motif      String?
  createdAt  DateTime      @default(now())

  tenant  Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  article Article @relation(fields: [articleId], references: [id])

  @@index([tenantId])
  @@index([articleId])
}

// ─── Frais ───────────────────────────────────────────────────────────────────

enum TypeFrais {
  DON
  PERTE_STOCK
  DEPLACEMENT
  REPAS
  HEBERGEMENT
  STAND
  AUTRE
}

model Frais {
  id         String    @id @default(uuid())
  tenantId   String
  sessionId  String?
  articleId  String?
  type       TypeFrais
  motif      String
  montantHT  Decimal?  @db.Decimal(10, 2)
  date       DateTime  @default(now())
  createdAt  DateTime  @default(now())
  actif      Boolean   @default(true)

  tenant  Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  session SessionCaisse? @relation(fields: [sessionId], references: [id])

  @@index([tenantId])
  @@index([sessionId])
}

// ─── Archivage journalier (loi anti-fraude TVA 2018) ─────────────────────────

model ArchiveJournaliere {
  id              String   @id @default(uuid())
  tenantId        String
  dateArchive     DateTime
  totalVentes     Int
  totalTTC        Decimal  @db.Decimal(12, 2)
  dernierHash     String   @db.VarChar(64)
  dernierNumero   Int
  createdAt       DateTime @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, dateArchive])
  @@index([tenantId])
}

// ─── Charges & abonnements ──────────────────────────────────────────────────

enum TypeCharge {
  DEPENSE
  ABONNEMENT
  PERTE
}

enum StatutCharge {
  PREVU
  PAYE
}

enum PeriodiciteAbonnement {
  MENSUELLE
  TRIMESTRIELLE
  SEMESTRIELLE
  ANNUELLE
}

// PCG-aligné : compte 60 / 61-62 / 63 / 65 / 67
enum CategorieCharge {
  ACHATS           // 60x — Impression, achat livres, matières
  SERVICES         // 61x-62x — SaaS, loyer, honoraires, assurance, télécom
  IMPOTS_TAXES     // 63x — CFE, taxes professionnelles, TVA non récupérable
  AUTRES_CHARGES   // 65x — Autres charges de gestion courante
  CHARGES_EXCEPT   // 67x — Pertes, sinistres, charges exceptionnelles
}

model Charge {
  id                String                 @id @default(uuid())
  tenantId          String
  libelle           String
  montantHT         Decimal                @db.Decimal(10, 2)
  tauxTVA           Decimal                @default(0) @db.Decimal(5, 2)
  type              TypeCharge
  categorie         CategorieCharge        @default(SERVICES)
  statut            StatutCharge           @default(PREVU)
  dateEffet         DateTime
  datePaiement      DateTime?
  periodicite       PeriodiciteAbonnement?
  prochaineEcheance DateTime?
  actif             Boolean                @default(true)
  notes             String?
  createdAt         DateTime               @default(now())
  updatedAt         DateTime               @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([tenantId, statut])
}
