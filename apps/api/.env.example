# Base de données
DATABASE_URL="postgresql://user:password@localhost:5432/megesti_dev"

# Serveur
PORT=3001
HOST=0.0.0.0
LOG_LEVEL=info
UPLOAD_DIR=/var/megesti/uploads
# Fichiers sensibles (CNI des dossiers PDP, chiffrés) — JAMAIS sous UPLOAD_DIR (servi en statique)
PRIVATE_DIR=/var/megesti/private

# Sécurité (min 32 caractères en prod)
JWT_SECRET="changeme-in-production-min-32-chars"
CAISSE_SECRET="changeme-in-production-min-32-chars"
ENCRYPTION_KEY="changeme-in-production-min-32-chars"

# CORS — domaines autorisés (virgule-séparés)
# Dev :
# CORS_ORIGIN=http://localhost:5173,http://localhost:5174
# Prod :
CORS_ORIGIN=https://app.megesti.fr,https://admin.megesti.fr

# Redis (BullMQ + cache)
REDIS_URL=redis://localhost:6379

# Stripe (optionnel si facturation électronique activée)
STRIPE_SECRET_KEY=sk_live_...
STRIPE_WEBHOOK_SECRET=whsec_...
APP_URL=https://app.megesti.fr

# Facturation électronique (PDP)
# Mode : superpdp (défaut) ou afnor
PDP_MODE=superpdp
SUPERPDP_CLIENT_ID=
SUPERPDP_CLIENT_SECRET=

# ─── E-mails transactionnels (reinitialisation de mot de passe) ───────────────
# URL publique du front, sert a construire le lien envoye par e-mail.
APP_URL=https://app.megesti.fr

# console = ecrit l'e-mail dans les logs (developpement)
# smtp    = envoi reel
MAIL_TRANSPORT=smtp
MAIL_FROM="MeGesti <contact@megesti.fr>"

# N'importe quel serveur SMTP convient : la boite du domaine, un relais
# transactionnel, ou un Postfix local. Aucune dependance a un prestataire.
SMTP_HOST=mail.megesti.fr
SMTP_PORT=587
SMTP_USER=contact@megesti.fr
SMTP_PASS=
# true pour le port 465 (TLS implicite) ; laisser vide pour 587 (STARTTLS)
SMTP_SECURE=
