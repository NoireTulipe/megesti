# Base de données
DATABASE_URL="postgresql://user:password@localhost:5432/megesti_dev"

# Serveur
PORT=3001
HOST=0.0.0.0
LOG_LEVEL=info
UPLOAD_DIR=/var/megesti/uploads

# Sécurité (min 32 caractères en prod)
JWT_SECRET="changeme-in-production-min-32-chars"
CAISSE_SECRET="changeme-in-production-min-32-chars"
ENCRYPTION_KEY="changeme-in-production-min-32-chars"

# CORS — domaines autorisés (virgule-séparés)
# Dev :
# CORS_ORIGIN=http://localhost:5173,http://localhost:5174
# Prod :
CORS_ORIGIN=https://app.megesti.fr,https://admin.megesti.fr

# Redis (BullMQ + cache)
REDIS_URL=redis://localhost:6379

# Stripe (optionnel si facturation électronique activée)
STRIPE_SECRET_KEY=sk_live_...
STRIPE_WEBHOOK_SECRET=whsec_...
APP_URL=https://app.megesti.fr

# Facturation électronique (PDP)
# Mode : superpdp (défaut) ou afnor
PDP_MODE=superpdp
SUPERPDP_CLIENT_ID=
SUPERPDP_CLIENT_SECRET=
