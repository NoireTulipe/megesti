{
  "expo": {
    "name": "MeGesti",
    "slug": "megesti-mobile",
    "version": "0.0.1",
    "orientation": "portrait",
    "scheme": "megesti",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "icon": "./assets/images/icon.png",
    "splash": {
      "image": "./assets/images/splash-logo.png",
      "backgroundColor": "#FFF9F5"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.megesti.app"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#FFF9F5"
      },
      "package": "com.megesti.app"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-sqlite",
      "expo-font",
      [
        "expo-camera",
        {
          "cameraPermission": "Permettre à MeGesti d'utiliser l'appareil photo pour scanner les codes-barres ISBN."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
